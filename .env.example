# Required secrets for the Cloudflare Worker.
# Set in production via:   cd apps/api && wrangler secret put <NAME>
# Set in local dev   via:  apps/api/.dev.vars   (gitignored)
#
# Do NOT commit real values to git.

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                 # service role, server-side only
SUPABASE_WEBHOOK_SECRET=                         # random 32-byte hex; also pasted into Supabase webhook header

# Resend (transactional email)
RESEND_API_KEY=re_...

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=0x...                       # secret key; site key stays in HTML

# Telegram (admin notifications)
TELEGRAM_BOT_TOKEN=12345:ABC...
# TELEGRAM_CHAT_ID is set as a non-secret var in wrangler.toml (currently -5234908131)
